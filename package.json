{
  "name": "@clawsean/task-call",
  "version": "0.1.0",
  "description": "Constrained outbound task-call companion for OpenClaw Voice Call",
  "type": "module",
  "private": false,
  "files": [
    "docs",
    "patches",
    "scripts/apply-openclaw-seam.mjs",
    "scripts/check-openclaw-compat.mjs",
    "scripts/check.mjs",
    "scripts/openclaw-target.mjs",
    "src",
    "LICENSE",
    "README.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "compat": "node scripts/check-openclaw-compat.mjs",
    "seam": "node scripts/apply-openclaw-seam.mjs"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
